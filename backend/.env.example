# Copie este arquivo para .env e preencha os valores. O .env nunca é versionado.

NODE_ENV=development
# 0.0.0.0 aceita conexões da rede local (o celular com Expo Go)
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# PostgreSQL local (mesmos dados que você usa no pgAdmin).
# Crie os bancos DB_NAME e DB_NAME_TEST no pgAdmin antes de rodar as migrations.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=shifty
DB_NAME_TEST=shifty_test

# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

# Origens de navegador permitidas, separadas por vírgula. O app nativo não usa CORS.
CORS_ORIGINS=

# console: o código de verificação aparece só no log do servidor (desenvolvimento)
# smtp: envia e-mail de verdade (preencha as variáveis SMTP_*)
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Shifty <no-reply@shifty.app>"
